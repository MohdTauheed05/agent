# Client-visible provider selector. Use a supported real provider.
NEXT_PUBLIC_AI_PROVIDER=openai

# Server-only AI credentials. Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model overrides
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-6
GEMINI_TEXT_MODEL=gemini-1.5-flash

# Real video generation used by Motion.
RUNWAYML_API_SECRET=
RUNWAY_VIDEO_MODEL=gen4.5
RUNWAY_VIDEO_RATIO=1280:720
